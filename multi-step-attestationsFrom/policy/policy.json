{
  "_comment": "Multi-step release-gate policy demonstrating the attestationsFrom cross-step contract. Three steps — build, scan, release — where release.regopolicies pulls predicates from the earlier two steps via attestationsFrom. The release step asserts (a) the scan ran against the artifact the build produced (by checking the scan step has an inclusion-proof attestation whose treeRoot equals the build's product Merkle root), and (b) the scan found zero SARIF error-level findings. Neither check is expressible without attestationsFrom: a single-step Rego block can only see its own step's attestations.",
  "expires": "2027-12-31T23:59:59Z",
  "name": "multi-step-release-gate-v1",
  "roots": {},
  "publickeys": {
    "11d36edf6b1693459d22494f1997415e7d63113b06fa8e54657a1fb178566f59": {
      "_comment": "Shared example signer key. In production, replace with a Fulcio cert constraint matching the build / scan / release workflow OIDC identities (each step may pin a different identity).",
      "keyid": "11d36edf6b1693459d22494f1997415e7d63113b06fa8e54657a1fb178566f59",
      "key": ""
    }
  },
  "steps": {
    "build": {
      "_comment_step": "Stage 1 — build the artifact. cilock run wraps the build command and emits the v0.3 product + material attestations. The product attestation's tree:products subject (a Merkle root) is the canonical artifact identity that later steps' inclusion-proof attestations reference.",
      "name": "build",
      "attestations": [
        { "type": "https://aflock.ai/attestations/environment/v0.1" },
