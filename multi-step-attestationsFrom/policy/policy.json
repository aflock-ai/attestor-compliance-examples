        { "type": "https://aflock.ai/attestations/product/v0.3" }
      ],
      "functionaries": [
        { "type": "publickey", "publickeyid": "11d36edf6b1693459d22494f1997415e7d63113b06fa8e54657a1fb178566f59" }
      ]
    },
    "scan": {
      "_comment_step": "Stage 2 — scan the artifact. The scanner consumes the build's product (so the build's product Merkle root is one of the scan's material leaves) and emits a SARIF attestation plus an inclusion-proof attestation whose treeRoot equals the build's product tree root. The inclusion-proof attestation is what cryptographically binds the SARIF findings to a specific build's artifact identity.",
      "name": "scan",
      "attestations": [
        { "type": "https://aflock.ai/attestations/environment/v0.1" },
        { "type": "https://aflock.ai/attestations/material/v0.3" },
        { "type": "https://aflock.ai/attestations/command-run/v0.1" },
        { "type": "https://aflock.ai/attestations/sarif/v0.1" },
        { "type": "https://aflock.ai/attestations/inclusion-proof/v0.1" }
      ],
      "functionaries": [
        { "type": "publickey", "publickeyid": "11d36edf6b1693459d22494f1997415e7d63113b06fa8e54657a1fb178566f59" }
      ]
    },
    "release": {
      "_comment_step": "Stage 3 — release gate. attestationsFrom: [\"build\", \"scan\"] tells the policy engine to surface attestations from those steps under input.steps.build.<type> and input.steps.scan.<type> when evaluating this step's regopolicies. The Rego module asserts the cross-step invariants: scan must prove inclusion against build's product root, and SARIF findings must be clean.",
      "name": "release",
