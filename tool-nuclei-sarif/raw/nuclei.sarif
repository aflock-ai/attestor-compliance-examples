						{
							"id": "wordpress-eol",
							"name": "WordPress End-of-Life - Detect",
							"shortDescription": {
								"text": "WordPress End-of-Life - Detect (wordpress-eol) found on public-firing-range.appspot.com"
							},
							"fullDescription": {
								"text": "Detected WordPress versions that have reached End-of-Life (EOL) and no longer receive security updates.\n\nMore details at\nhttps://cloud.projectdiscovery.io/public/wordpress-eol\n"
							},
							"properties": {
								"security-severity": "1",
								"tags": [
									"security"
								]
							}
						},
						{
							"id": "google-frontend-httpserver",
